PORT=8787

# ---- LLM gateway: OpenRouter only (Groq + DeepSeek removed) ---------------
# One key at openrouter.ai/keys. Paid lowest-cost defaults:
# primary brain z-ai/glm-5.3-flash, fast openai/gpt-oss-20b.
# Free :free quota (1000/day after $10 credits) sits BEHIND paid in all chains.
OPENROUTER_API_KEY=your_openrouter_key_here
# OR_PRIMARY_MODEL=z-ai/glm-5.3-flash
# OR_FAST_MODEL=openai/gpt-oss-20b
# OR_DRAFT_MODEL=qwen/qwen3-30b-a3b-2507
# OR_IMAGE_MODEL=google/gemini-2.5-flash-image
# OR_STT_MODEL=openai/whisper-large-v3
# OR_VIDEO_MODEL=google/veo-3.1-lite
# OR_FREE_FAST=openai/gpt-oss-20b:free
# OR_FREE_DRAFT=qwen/qwen3-30b-a3b-2507:free

# ---- Per-role model overrides (all optional) ------------------------------
# Prefix `openrouter:` forces OpenRouter; `go:`/`zen:` force OpenCode;
# `gemini-*` forces Gemini native; anything else routes to Mistral.
# AGENT_MODEL=openrouter:z-ai/glm-5.3-flash
# TOOLS_MODEL=openrouter:z-ai/glm-5.3-flash
# CONVERSATION_MODEL=openrouter:z-ai/glm-5.3-flash
# FAST_MODEL=openai/gpt-oss-20b
# CODING_MODEL=openrouter:z-ai/glm-5.3-flash
# VISION_MODEL=gemini-3.6-flash

# On-device offline fallback run by the Android app when there is no
# connectivity. This server never calls it over HTTP.
# LOCAL_MODEL=gemma-3n-e2b

# Legacy fallbacks (kept AFTER OpenRouter in every chain — optional):
# GEMINI_API_KEY=your_gemini_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_FAST_MODEL=mistral-small-latest
# NOTE: the live .env key is MISTRAL_VOXTRAL_MODEL — the code reads
# MISTRAL_VOXTRAIL_MODEL; fix the spelling to make the override work.
# MISTRAL_VOXTRAIL_MODEL=voxtral-mini-transcribe-realtime
# OPENCODE_ZEN_API_KEY=
# OPENCODE_ZEN_MODEL=glm-5.3-flash
# OPENCODE_GO_MODEL=glm-5.3-flash
# OPENAI_API_KEY= (STT fallback only)

# ---- Search ---------------------------------------------------------------
# Brave official API, free tier key (unfunded OK) — 4th engine. Unset = skipped.
# BRAVE_API_KEY=your_brave_key_here

TWELVE_DATA_KEY=your_twelvedata_key_here
SANDBOX_URL=https://sandbox-rexv.onrender.com
# Auth token for the SANDBOX service (code: SANDBOX_AUTH or SANDBOX_AUTH_TOKEN).
SANDBOX_AUTH=your_sandbox_auth_here
# LOCAL_SANDBOX_URL= (dev override, tried before SANDBOX_URL)
# REQUIRED — the server refuses to boot without one (agentic security)
AUTH_TOKEN=your_auth_token_here
# REQUIRED IN PRODUCTION — separate secret for approve/mint/refunds/ledger.
# Without it, admin routes fall back to AUTH_TOKEN (dev only).
# ADMIN_TOKEN=your_admin_token_here
MT5_BRIDGE_URL=
GSRI_SNAPSHOT_PATH=
GSRI_REMOTE_URL=

# ---- Persistence ----------------------------------------------------------
# Render disk is ephemeral: mount a disk at /data (auto-used) or set DB_PATH.
# DB_PATH=/data/frit.db
# Off-site backup to Supabase Storage (free 1GB, no card): hourly + on-approve
# pushes, auto-restore on boot. Needs the SERVICE_ROLE (secret) key — the
# publishable key cannot upload.
# SUPABASE_URL=https://xyz.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_...
# SUPABASE_BUCKET=frit-backups

# ---- Monetization ---------------------------------------------------------
# YOUR receiving bank account (manual-transfer rail):
PAY_BANK_NAME=Access Bank
PAY_ACCOUNT_NUMBER=10_digits_here
PAY_ACCOUNT_NAME=Uchechukwu Ozurumba Gift
# Crypto rails (static deposit addresses from YOUR Binance wallet):
# BTC_ADDRESS=bc1...
# USDT_TRON_ADDRESS=T...
# Owner mastercode: redeem in-app for lifetime owner tier. Min 8 chars.
# MASTER_CODE=change_me_to_something_long

# ---- MTF strategy engine (server/src/strategy) ----------------------------
# Auto-start the daily trade-task scheduler ("everyday analyze XAUUSD") at boot.
# Tasks are added at runtime via POST /tasks/trade-schedule. Paper-first: stays
# paper while MT5_BRIDGE_URL is empty.
# TRADE_TASKS=true

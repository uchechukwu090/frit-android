# =====================================================================
# FRIT — ALL API KEYS & SETTINGS IN ONE PLACE
# Copy this file to `.env` (same folder) and paste each key beside its name.
# Lines starting with # are ignored. Values with spaces need no quotes.
# The Android app bakes FRIT_BASE_URL + AUTH_TOKEN from server/.env at build
# time, so rebuild the app after changing those two.
# =====================================================================

# ---- Server basics --------------------------------------------------
PORT=8787
# NODE_ENV=production (set this on Render/Railway)
# DB_PATH=/data/frit.db (persistent disk; auto-uses /data if mounted)

# =====================================================================
# 1) REQUIRED — the app refuses to boot without AUTH_TOKEN
# =====================================================================
# Get: you invent this (long random string). Paste SAME value in app Settings
# as the API token, OR mint per-user keys via /admin/keys.
AUTH_TOKEN=
# Separate secret for approvals/mints/refunds. Falls back to AUTH_TOKEN if empty (dev only).
ADMIN_TOKEN=
# Owner mastercode: redeem in-app for lifetime owner tier (min 8 chars, you invent it).
MASTER_CODE=
# Public base URL of THIS server (for lip-sync webhooks). On Render it is auto-detected;
# set manually only if auto-detect fails. Example: https://frit-android.onrender.com
PUBLIC_BASE_URL=

# Address baked into the Android app at build time (defaults to Render URL below).
FRIT_BASE_URL=https://frit-android.onrender.com

# =====================================================================
# 2) OPENROUTER — the single AI gateway (REQUIRED — get: openrouter.ai/keys)
# Top up credits at openrouter.ai/credits (image/video need PAID credits).
# =====================================================================
OPENROUTER_API_KEY=

# NOTE: every slug below can now be changed LIVE from the app's Creator
# console (Models section) with zero redeploy — env values are boot defaults.
# ---- Chat brains (model slugs, all optional — defaults shown) -------
OR_PRIMARY_MODEL=z-ai/glm-5.3-flash
OR_FAST_MODEL=openai/gpt-oss-20b
OR_DRAFT_MODEL=deepseek/deepseek-v4-flash
# OR_DIRECTOR_MODEL= (Cinema AI director; defaults to OR_FAST_MODEL)
# Free-tier fallbacks (1000/day after $10 credits; auto-picked if blank):
OR_FREE_FAST=qwen/qwen3.8-27b:free
OR_FREE_DRAFT=nvidia/nemotron-3-super-120b-a12b:free
# Optional provider pinning (same model, cheaper endpoint — e.g. deepinfra):
OR_PROVIDER_ONLY=
OR_PROVIDER_SORT=

# ---- Image / design models (OpenRouter slugs) -----------------------
OR_IMAGE_MODEL=bytedance-seed/seedream-5-0-flash
OR_DESIGN_MODEL=inclusionai/ming-image-0.1-design
OR_LAYER_MODEL=inclusionai/ming-image-0.1-design-layer
# Graphics craft routing (verify slugs at openrouter.ai/models; blank = safe fallback):
# typography-led posters/ads -> Ideogram-class:
OR_TYPE_MODEL=
# logos/vectors/brand systems -> Recraft-class:
OR_VECTOR_MODEL=
# default graphics engine when craft unset (FREE design specialist):
OR_GRAPHICS_MODEL=inclusionai/ming-image-0.1-design

# ---- Voice (speech-to-text) -----------------------------------------
OR_STT_MODEL=openai/whisper-large-v3
# OPENAI_API_KEY= (STT fallback only, get: platform.openai.com/api-keys)

# ---- Video models (OpenRouter slugs — see GET /creative-suite/videos/models)
# Primary: HeyGen Video (promo $0.01/s WITH audio). Alt: google/veo-3.1-lite
OR_VIDEO_MODEL=heygen/heygen-video-1
# Genjutsu default: reference-capable model, 4-30s, video/audio refs:
OR_GENJUTSU_MODEL=bytedance/seedance-2.5

# =====================================================================
# 3) AVATAR + LIP-SYNC engines (optional — without these, local dub runs instead)
# =====================================================================
# Primary talking avatar: HeyGen Avatar IV via OpenRouter ($0.05/s, photo+voice,
# to 1080p — same OpenRouter key, NO extra subscription):
OR_AVATAR_MODEL=heygen/avatar-iv
# Neural mouth re-animation, $0.08/s — get: synclabs.so (API keys page).
SYNC_LABS_API_KEY=
# Talking-avatar FALLBACK from one photo (primary is OR_AVATAR_MODEL above),
# ~$0.05/s — get: hedra.com (Developer Platform).
HEDRA_API_KEY=

# =====================================================================
# 4) PER-ROLE model overrides (all optional)
# Prefix `openrouter:` forces OpenRouter; `go:`/`zen:` force OpenCode Zen;
# anything else routes to Mistral.
# =====================================================================
# AGENT_MODEL=openrouter:z-ai/glm-5.3-flash
# CONVERSATION_MODEL=openrouter:z-ai/glm-5.3-flash
# TOOLS_MODEL=openrouter:z-ai/glm-5.3-flash
# CODING_MODEL=openrouter:z-ai/glm-5.3-flash
# FAST_MODEL=openrouter:openai/gpt-oss-20b
# VISION_MODEL=openrouter:z-ai/glm-5.3-flash
# LOCAL_MODEL=gemma-3n-e2b (on-device Android fallback; server never calls it)
# OPENCODE_GO_MODEL=glm-5.3-flash
# OPENCODE_ZEN_MODEL=glm-5.3-flash

# ---- Legacy fallbacks (sit BEHIND OpenRouter in every chain) ---------
# MISTRAL_API_KEY= (get: console.mistral.ai)
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_FAST_MODEL=mistral-small-latest
# NOTE exact spelling — code reads MISTRAL_VOXTRAIL_MODEL (with an I).
# If your live .env has MISTRAL_VOXTRAL_MODEL (no I), it is silently ignored:
# MISTRAL_VOXTRAIL_MODEL=voxtral-mini-transcribe-realtime
# OPENCODE_ZEN_API_KEY=

# =====================================================================
# 5) SEARCH — deep web research engines (optional, skipped if blank)
# =====================================================================
# BRAVE_API_KEY= (get: brave.com/search/api — free tier OK)

# =====================================================================
# 6) MARKET DATA (trading suite)
# =====================================================================
TWELVE_DATA_KEY=
# FINNHUB_KEY= (get: finnhub.io/dashboard — free; 24/7 live forex/metals feed)
# FEED_ENABLED=1 (set 0 for REST-only mode)
# FEED_BACKFILL_BUDGET=200 (max Twelve Data credits/day for gap backfill)
# TRADIER_TOKEN= (get: tradier.com — options chains; sandbox URL default)
# TRADIER_BASE=https://sandbox.tradier.com

# =====================================================================
# 7) SANDBOX — code execution + ffmpeg video assembly (separate service)
# These go in the MAIN server env. The sandbox service itself needs
# SANDBOX_AUTH_TOKEN (= same value) in ITS env dashboard.
# =====================================================================
SANDBOX_URL=https://sandbox-rexv.onrender.com
SANDBOX_AUTH=
# SANDBOX_AUTH_TOKEN= (same value as SANDBOX_AUTH; either name works)
# LOCAL_SANDBOX_URL= (dev override, tried before SANDBOX_URL)

# =====================================================================
# 8) TRADING bridge
# =====================================================================
MT5_BRIDGE_URL=
# TRADE_TASKS=true (auto-start daily trade-task scheduler at boot; paper-first)

# =====================================================================
# 9) PERSISTENCE — Supabase off-site backup (free 1GB, no card)
# Get: supabase.com dashboard -> your project -> Settings -> API.
# Needs the SERVICE_ROLE (secret) key — the publishable key cannot upload.
# =====================================================================
# SUPABASE_URL=https://xyz.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_...
# SUPABASE_BUCKET=frit-backups

# =====================================================================
# 10) MONEY — manual bank rail + crypto rails (YOUR receiving accounts)
# =====================================================================
PAY_BANK_NAME=Access Bank
PAY_ACCOUNT_NUMBER=10_digits_here
PAY_ACCOUNT_NAME=Uchechukwu Ozurumba Gift
# BTC_ADDRESS=bc1... (native Bitcoin; empty = native-BTC rail off)
# USDT_TRON_ADDRESS=T... (Tron USDT; no keyless verify — manual approve path)
# BSC_ADDRESS=0x... (ONE address for USDT+BTC on BNB Smart Chain — auto-verify)
# BSC_RPC=https://bsc-dataseed.binance.org/

# =====================================================================
# 11) STRATEGY TUNING (all optional — defaults shown)
# =====================================================================
# RISK_MAX_OPEN=4 (max concurrent paper positions)
# RISK_MAX_TRADE_PCT=2 (max % risk per trade)
# RISK_MAX_DAILY_LOSS_PCT=4
# RISK_MAX_USD_NET_PCT=3
# RISK_MAX_PER_GROUP=2
# OPT_MAX_OPEN=3 (options paper positions)
# OPT_MAX_SIGNALS_DAY=3
# PEG_FLOOR=1370
# COST_OVERRIDES_JSON={"XAUUSD":{"spread":0.25}}

# =====================================================================
# SANDBOX SERVICE env (paste these in the SANDBOX Render dashboard,
# NOT here — listed so nothing is forgotten):
#   SANDBOX_AUTH_TOKEN=<same value as SANDBOX_AUTH above>
#   PORT=8790 (default; or SANDBOX_PORT)
#   MAX_CONCURRENT_JOBS=2 | PY_MEM_LIMIT_MB=256 | SANDBOX_CACHE=1
# =====================================================================

PORT=8787

# ---- Cloud providers -----------------------------------------------
# The chat/function/tool/classify/coding roles default to Groq when GROQ_API_KEY
# is set (fast, reliable function-calling). Vision falls back to Gemini when a
# GEMINI_API_KEY is present. Mistral is the fallback if neither is available.
# Add AT LEAST ONE of GROQ_API_KEY / GEMINI_API_KEY / MISTRAL_API_KEY.
# GROQ_API_KEY=your_groq_key_here
# GEMINI_API_KEY=your_gemini_key_here
# MISTRAL_API_KEY=your_mistral_api_key_here

# ---- Per-role model overrides (all optional) ------------------------------
# Use `groq:` as a prefix to force a Groq model; `gemini-*` forces Gemini;
# anything else routes to Mistral. Omit to get the sensible default below.
# AGENT_MODEL=groq:llama-3.3-70b-versatile
# TOOLS_MODEL=groq:llama-3.3-70b-versatile
# CONVERSATION_MODEL=groq:llama-3.1-8b-instant
# FAST_MODEL=groq:llama-3.1-8b-instant
# CODING_MODEL=groq:qwen/qwen3.6-27b
# VISION_MODEL=gemini-2.0-flash

# On-device offline fallback run by the Android app when there is no
# connectivity. This server never calls it over HTTP. Gemma 3n E2B (~2GB
# active) is a low-stakes classification/routing-only fallback, NOT the
# agent brain (kept on Groq / Gemini in the cloud).
# LOCAL_MODEL=gemma-3n-e2b

# Legacy Mistral path overrides (only honoured if you keep using Mistral).
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_FAST_MODEL=mistral-small-latest
# MISTRAL_VISION_MODEL=pixtral-large-latest
# MISTRAL_VOXTRAIL_MODEL=voxtral-mini-transcribe-realtime

TWELVE_DATA_KEY=your_twelvedata_key_here
SANDBOX_URL=https://sandbox-production-839a.up.railway.app
# REQUIRED — the server refuses to boot without one (agentic security)
AUTH_TOKEN=your_auth_token_here
MT5_BRIDGE_URL=
GSRI_SNAPSHOT_PATH=
GSRI_REMOTE_URL=

# ---- MTF strategy engine (server/src/strategy) ----------------------------
# Auto-start the daily trade-task scheduler ("everyday analyze XAUUSD") at boot.
# Tasks are added at runtime via POST /tasks/trade-schedule. Paper-first: stays
# paper while MT5_BRIDGE_URL is empty.
# TRADE_TASKS=true
